# Loupe — Beispielkonfiguration
#
# Lokal: als .env in den Projektordner legen und ausfüllen.
# Railway: dieselben Schlüssel unter Variables eintragen, ohne Anführungszeichen.
#
# Pflicht sind OPENAI_API_KEY, APP_BENUTZER, APP_PASSWORT und SECRET_KEY.
# Der Rest hat brauchbare Vorgaben.
#
# Kein Objektspeicher nötig: Das Video geht stückweise direkt zur Anwendung
# und wird nach der Extraktion verworfen. Auf dem Volume bleiben nur die
# Kandidaten und die fertigen Thumbnails, 2-11 MB je Job.


# --- Bewertung -------------------------------------------------------------

OPENAI_API_KEY=sk-...

# Modell für Stufe 4. Gemessen über fünf Testvideos, je Lauf:
#   gpt-5.6-luna    ~1,45 ct   ($1 / $6 je Mio. Token)
#   gpt-5.6-terra   ~3,63 ct   ($2,50 / $15)
#   gpt-5.6-sol     ~7,26 ct   ($5 / $30)
# Die Kosten hängen an der Kandidatenzahl, nicht an der Videolänge.
OPENAI_MODEL=gpt-5.6-luna

# Modell für die optionale Tonspur-Auswertung. Nur wirksam, wenn der Schalter
# „Tonspur auswerten" angehakt ist — Vorgabe aus.
#
# Bewusst ein Modell OHNE Zeitstempel: whisper-1 kann sie und kostet das
# Doppelte, aber die Messung vor dem Einbau zeigte, dass die zeitliche
# Zuordnung die Auswahl nicht verbessert. Was half, war das Vokabular für die
# Begründungen — und das ist ein globaler Effekt.
#   gpt-4o-mini-transcribe   $0,003/min   (~0,8 ct für ein 2:45-Video)
#   gpt-4o-transcribe        $0,006/min
OPENAI_TRANSKRIPT_MODELL=gpt-4o-mini-transcribe


# --- Anmeldung -------------------------------------------------------------

# Zugangsschutz, keine Nutzerkonten. Ohne diese Schranke kann jeder, der die
# Adresse kennt, das OpenAI-Budget verbrauchen.
# Das Passwort lang und zufällig wählen, etwa mit
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# Nach fünf Fehlversuchen in 15 Minuten sperrt die Anmeldung den Absender.
APP_BENUTZER=redaktion
APP_PASSWORT=hier-ein-langes-passwort-eintragen

# Signiert das Sitzungs-Cookie. Ohne festen Wert werden alle Anmeldungen bei
# jedem Neustart ungültig. Erzeugen mit:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=


# --- Upload ----------------------------------------------------------------

# Obergrenze für den Upload, in MB. Wird beim Anmelden geprüft, damit der
# Nutzer es vor der Übertragung erfährt.
MAX_UPLOAD_MB=2048

# Angefangene und nie beendete Uploads werden nach dieser Frist verworfen.
UPLOAD_VERFALL_STUNDEN=24


# --- Ablage und Betrieb ----------------------------------------------------

# Muss auf ein gemountetes Railway-Volume zeigen. Ohne Volume ist das
# Dateisystem flüchtig: Job-Datenbank, Kandidaten und fertige Thumbnails wären
# nach jedem Deploy weg. Seit dem Wegfall des Objektspeichers hängt alles
# daran — 10 GB reichen für rund 1000 aufbewahrte Jobs.
DATEN_PFAD=/data

# Aufbewahrung von Jobs, Kandidaten und Thumbnails. Das Quellvideo fällt
# nicht darunter — es wird direkt nach der Extraktion gelöscht.
AUFBEWAHRUNG_TAGE=28

# Gleichzeitige Jobs. ffmpeg ist CPU-gebunden — zwei parallele Läufe auf einer
# geteilten CPU machen beide langsam statt einen schnell. Erst erhöhen, wenn
# die Instanz mehr als zwei vCPU hat.
GLEICHZEITIG=1

# Setzt Railway selbst. Lokal optional.
# PORT=8000
